# Skip automatic peer-dependency installation.
#
# package-lock.json is not committed, so every install (CI, Railway image
# build, local) resolves the tree fresh. Since mid-Oct/2026 that fresh tree
# crashes npm 10's resolver in #loadPeerSet ("Cannot read properties of null
# (reading 'edgesOut')") — triggered by recently published optional peers
# (vitest's @vitest/browser-* packages and their puppeteer-core range).
# Nothing in this app relies on auto-installed peers, so legacy peer handling
# avoids the crash without pinning old versions (whatsapp-web.js must stay
# current to keep up with WhatsApp Web).
legacy-peer-deps=true
